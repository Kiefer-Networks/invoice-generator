<?xml version="1.0" encoding="UTF-8"?>
<rsm:CrossIndustryInvoice xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100" xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100" xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">
<rsm:ExchangedDocumentContext><ram:GuidelineSpecifiedDocumentContextParameter><ram:ID>urn:cen.eu:en16931:2017</ram:ID></ram:GuidelineSpecifiedDocumentContextParameter></rsm:ExchangedDocumentContext>
<rsm:ExchangedDocument><ram:ID>{{esc .Draft.Number}}</ram:ID><ram:TypeCode>{{if eq .Kind "correction"}}384{{else}}380{{end}}</ram:TypeCode><ram:IssueDateTime><udt:DateTimeString format="102">{{date .Draft.IssueDate}}</udt:DateTimeString></ram:IssueDateTime>{{if .Notes}}<ram:IncludedNote><ram:Content>{{esc .Notes}}</ram:Content></ram:IncludedNote>{{end}}</rsm:ExchangedDocument>
<rsm:SupplyChainTradeTransaction>
{{range $i,$l:=.Draft.Lines}}<ram:IncludedSupplyChainTradeLineItem>
<ram:AssociatedDocumentLineDocument><ram:LineID>{{inc $i}}</ram:LineID></ram:AssociatedDocumentLineDocument>
<ram:SpecifiedTradeProduct><ram:Name>{{esc .Title}}</ram:Name>{{if .Description}}<ram:Description>{{esc .Description}}</ram:Description>{{end}}</ram:SpecifiedTradeProduct>
<ram:SpecifiedLineTradeAgreement><ram:NetPriceProductTradePrice><ram:ChargeAmount>{{money .UnitPriceMinor}}</ram:ChargeAmount></ram:NetPriceProductTradePrice></ram:SpecifiedLineTradeAgreement>
<ram:SpecifiedLineTradeDelivery><ram:BilledQuantity unitCode="{{unit .Unit}}">{{qty .QuantityScaled}}</ram:BilledQuantity></ram:SpecifiedLineTradeDelivery>
<ram:SpecifiedLineTradeSettlement><ram:ApplicableTradeTax><ram:TypeCode>VAT</ram:TypeCode><ram:CategoryCode>{{cat .TaxRateBasisPoints}}</ram:CategoryCode><ram:RateApplicablePercent>{{money .TaxRateBasisPoints}}</ram:RateApplicablePercent></ram:ApplicableTradeTax>{{if .DiscountBasisPoints}}<ram:SpecifiedTradeAllowanceCharge><ram:ChargeIndicator><udt:Indicator>false</udt:Indicator></ram:ChargeIndicator><ram:CalculationPercent>{{money .DiscountBasisPoints}}</ram:CalculationPercent><ram:BasisAmount>{{base .}}</ram:BasisAmount><ram:ActualAmount>{{allowance .}}</ram:ActualAmount><ram:Reason>Discount</ram:Reason></ram:SpecifiedTradeAllowanceCharge>{{end}}<ram:SpecifiedTradeSettlementLineMonetarySummation><ram:LineTotalAmount>{{money .NetMinor}}</ram:LineTotalAmount></ram:SpecifiedTradeSettlementLineMonetarySummation></ram:SpecifiedLineTradeSettlement>
</ram:IncludedSupplyChainTradeLineItem>{{end}}
<ram:ApplicableHeaderTradeAgreement>
<ram:SellerTradeParty><ram:Name>{{esc .Company.LegalName}}</ram:Name>{{if .Company.ContactName}}<ram:DefinedTradeContact><ram:PersonName>{{esc .Company.ContactName}}</ram:PersonName></ram:DefinedTradeContact>{{end}}<ram:PostalTradeAddress><ram:PostcodeCode>{{esc .Company.PostalCode}}</ram:PostcodeCode><ram:LineOne>{{esc .Company.AddressLine1}}</ram:LineOne>{{if .Company.AddressLine2}}<ram:LineTwo>{{esc .Company.AddressLine2}}</ram:LineTwo>{{end}}<ram:CityName>{{esc .Company.City}}</ram:CityName><ram:CountryID>{{esc .Company.Country}}</ram:CountryID></ram:PostalTradeAddress>{{if .Company.TaxNumber}}<ram:SpecifiedTaxRegistration><ram:ID schemeID="FC">{{esc .Company.TaxNumber}}</ram:ID></ram:SpecifiedTaxRegistration>{{end}}{{if .Company.VATIdentifier}}<ram:SpecifiedTaxRegistration><ram:ID schemeID="VA">{{esc .Company.VATIdentifier}}</ram:ID></ram:SpecifiedTaxRegistration>{{end}}</ram:SellerTradeParty>
<ram:BuyerTradeParty><ram:Name>{{if .Draft.Customer.LegalName}}{{esc .Draft.Customer.LegalName}}{{else}}{{esc .Draft.Customer.DisplayName}}{{end}}</ram:Name>{{if or .Draft.Customer.ContactName .Draft.Customer.Email}}<ram:DefinedTradeContact>{{if .Draft.Customer.ContactName}}<ram:PersonName>{{esc .Draft.Customer.ContactName}}</ram:PersonName>{{end}}{{if .Draft.Customer.Email}}<ram:EmailURIUniversalCommunication><ram:URIID>{{esc .Draft.Customer.Email}}</ram:URIID></ram:EmailURIUniversalCommunication>{{end}}</ram:DefinedTradeContact>{{end}}<ram:PostalTradeAddress><ram:PostcodeCode>{{esc .Draft.Customer.PostalCode}}</ram:PostcodeCode><ram:LineOne>{{esc .Draft.Customer.AddressLine1}}</ram:LineOne>{{if .Draft.Customer.AddressLine2}}<ram:LineTwo>{{esc .Draft.Customer.AddressLine2}}</ram:LineTwo>{{end}}<ram:CityName>{{esc .Draft.Customer.City}}</ram:CityName><ram:CountryID>{{esc .Draft.Customer.Country}}</ram:CountryID></ram:PostalTradeAddress>{{if .Draft.Customer.VATIdentifier}}<ram:SpecifiedTaxRegistration><ram:ID schemeID="VA">{{esc .Draft.Customer.VATIdentifier}}</ram:ID></ram:SpecifiedTaxRegistration>{{end}}</ram:BuyerTradeParty>
</ram:ApplicableHeaderTradeAgreement>
<ram:ApplicableHeaderTradeDelivery><ram:ActualDeliverySupplyChainEvent><ram:OccurrenceDateTime><udt:DateTimeString format="102">{{service .Draft.ServiceDate}}</udt:DateTimeString></ram:OccurrenceDateTime></ram:ActualDeliverySupplyChainEvent></ram:ApplicableHeaderTradeDelivery>
<ram:ApplicableHeaderTradeSettlement><ram:InvoiceCurrencyCode>{{esc .Draft.Currency}}</ram:InvoiceCurrencyCode>
{{if .Company.IBAN}}<ram:SpecifiedTradeSettlementPaymentMeans><ram:TypeCode>58</ram:TypeCode><ram:PayeePartyCreditorFinancialAccount><ram:IBANID>{{esc .Company.IBAN}}</ram:IBANID></ram:PayeePartyCreditorFinancialAccount>{{if .Company.BIC}}<ram:PayeeSpecifiedCreditorFinancialInstitution><ram:BICID>{{esc .Company.BIC}}</ram:BICID></ram:PayeeSpecifiedCreditorFinancialInstitution>{{end}}</ram:SpecifiedTradeSettlementPaymentMeans>{{end}}
{{range .Draft.TaxGroups}}<ram:ApplicableTradeTax><ram:CalculatedAmount>{{money .TaxMinor}}</ram:CalculatedAmount><ram:TypeCode>VAT</ram:TypeCode><ram:BasisAmount>{{money .NetMinor}}</ram:BasisAmount><ram:CategoryCode>{{cat .TaxRateBasisPoints}}</ram:CategoryCode><ram:RateApplicablePercent>{{money .TaxRateBasisPoints}}</ram:RateApplicablePercent></ram:ApplicableTradeTax>{{end}}
<ram:SpecifiedTradePaymentTerms><ram:Description>{{.Draft.Customer.PaymentTermsDays}} days</ram:Description><ram:DueDateDateTime><udt:DateTimeString format="102">{{date .Draft.DueDate}}</udt:DateTimeString></ram:DueDateDateTime></ram:SpecifiedTradePaymentTerms>
<ram:SpecifiedTradeSettlementHeaderMonetarySummation><ram:LineTotalAmount>{{money .Draft.NetMinor}}</ram:LineTotalAmount><ram:ChargeTotalAmount>0.00</ram:ChargeTotalAmount><ram:AllowanceTotalAmount>0.00</ram:AllowanceTotalAmount><ram:TaxBasisTotalAmount>{{money .Draft.NetMinor}}</ram:TaxBasisTotalAmount><ram:TaxTotalAmount currencyID="{{esc .Draft.Currency}}">{{money .Draft.TaxMinor}}</ram:TaxTotalAmount><ram:GrandTotalAmount>{{money .Draft.GrossMinor}}</ram:GrandTotalAmount><ram:DuePayableAmount>{{money .Draft.GrossMinor}}</ram:DuePayableAmount></ram:SpecifiedTradeSettlementHeaderMonetarySummation>
{{if .Correction.OriginalNumber}}<ram:InvoiceReferencedDocument><ram:IssuerAssignedID>{{esc .Correction.OriginalNumber}}</ram:IssuerAssignedID></ram:InvoiceReferencedDocument>{{end}}
</ram:ApplicableHeaderTradeSettlement></rsm:SupplyChainTradeTransaction></rsm:CrossIndustryInvoice>
