# Normalize line endings across Windows/macOS/Linux checkouts and diffs.
* text=auto eol=lf

*.go text eol=lf diff=golang
go.mod text eol=lf
go.sum text eol=lf -diff
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.html text eol=lf

# Windows batch/PowerShell scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never diff or convert line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.svg -text
